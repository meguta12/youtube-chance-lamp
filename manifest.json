{
  "manifest_version": 3,
  "name": "YouTube 伸びる!? CHANCE — チャンスランプ",
  "version": "1.2.0",
  "description": "再生数÷登録者数でチャンスを発見。レバーを引くと緑・赤・金・虹のランプと色別の告知音が反応します。",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core.js",
        "effects.js",
        "chance-ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "assets/nobiru-chance.png",
        "sounds/green.wav",
        "sounds/red.mp3",
        "sounds/gold.mp3",
        "sounds/rainbow.wav"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "伸びる!? CHANCE 設定・演出体験",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
